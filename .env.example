# --- Database ---
# SQLite by default (zero external services) for local dev.
# In production use Postgres (SQLite is wiped on ephemeral hosts). Run
# `scripts/db-provider.sh postgresql` and set a Postgres URL. See DEPLOY.md.
DATABASE_URL="file:./dev.db"
# Production example:
# DATABASE_URL="postgresql://user:password@host:5432/baton"

# --- Session ---
# Any long random string. Used to sign session JWTs.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- App ---
# Public base URL, used for OAuth redirect callbacks.
APP_URL="http://localhost:3000"

# --- Background worker ---
# Set to "true" on a web host that should NOT run the in-process job worker
# (for example Vercel). Run `npm run worker` on a long-lived host instead.
# EXTERNAL_WORKER="false"

# --- Public demo ---
# The Docker start script seeds the demo workspace on boot unless this is false.
# Set SEED_DEMO="false" for a private deployment that should not carry the demo.
# SEED_DEMO="true"

# --- GitHub OAuth ---
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: ${APP_URL}/api/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- AI provider ---
# Used by the BRD agent to write acceptance criteria (Given/When/Then).
# Without it Baton falls back to deterministic drafts, so the pipeline still runs.
ANTHROPIC_API_KEY=""
# Model id is configurable; defaults to a Sonnet model.
ANTHROPIC_MODEL="claude-sonnet-4-5"
